# Copy to .env for local reference only. .env is git-ignored. Placeholders only: no real secrets here.

# ---- Browser-safe (public) values: set on Render (Environment tab) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# ---- SERVER-ONLY secrets: set with `supabase secrets set ...`. NEVER in Render's static site, never in browser code ----
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically by Supabase.
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY      # same public key again, as a function secret
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=A_LONG_RANDOM_STRING
