{
  "name": "infinity-hearts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Infinity Hearts (Becam & Faith): offline-capable long-distance couple PWA",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "cap:sync": "npx cap sync android",
    "sync:shared": "node scripts/sync-shared.mjs",
    "seed:gen": "node scripts/gen-seed.mjs",
    "vapid": "node scripts/gen-vapid.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test:db": "bash tests/db/run.sh",
    "test:e2e": "python3 tests/e2e/smoke.py && python3 tests/e2e/cloud.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
